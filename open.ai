import os
from openai import OpenAI

# Initialize the client pointing to GitHub's inference endpoint
client = OpenAI(
    base_url="https://models.inference.ai.azure.com",
    api_key=os.environ.get("GITHUB_TOKEN"), # Replace with your github_pat_... token
)

response = client.chat.completions.create(
    messages=[
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Hello! Give me a quick coding tip."}
    ],
    model="gpt-4o", # Or "Llama-3.3-70B-Instruct", "DeepSeek-R1", etc.
    temperature=0.7,
    max_tokens=1024
)

print(response.choices[0].message.content)
